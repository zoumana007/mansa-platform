# Runtime
NODE_ENV=development
APP_ENV=demo
PORT=3000
API_PREFIX=v1

# Database — local placeholder only
DATABASE_URL=postgresql://mansa:mansa@localhost:5432/mansa?schema=public

# Cache and queues — local placeholder only
REDIS_URL=redis://localhost:6379

# Authentication — replace through a secret manager outside local development
JWT_ACCESS_SECRET=change-me-locally
JWT_REFRESH_SECRET=change-me-locally
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Ledger outbox worker — disabled until a real publisher adapter is bound
LEDGER_OUTBOX_WORKER_ENABLED=false
LEDGER_OUTBOX_INTERVAL_MS=1000
LEDGER_OUTBOX_BATCH_SIZE=50
LEDGER_OUTBOX_LEASE_MS=30000
LEDGER_OUTBOX_MAX_ATTEMPTS=10
LEDGER_OUTBOX_BASE_RETRY_DELAY_MS=1000
LEDGER_OUTBOX_MAX_RETRY_DELAY_MS=60000
LEDGER_OUTBOX_JITTER_RATIO=0.2

# Observability
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

# External providers remain disabled until adapters are configured
MOBILE_MONEY_PROVIDER=mock
CARD_PROCESSOR_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
