    },
    "./transaction-history": {
      "types": "./dist/transaction-history.d.ts",
      "import": "./dist/transaction-history.js"
    },
    "./correlation": {
      "types": "./dist/correlation.d.ts",
      "import": "./dist/correlation.js"
    },
    "./intelligence": {
      "types": "./dist/intelligence.d.ts",
      "import": "./dist/intelligence.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
