    "./permission-catalog": {
      "types": "./dist/permission-catalog.d.ts",
      "import": "./dist/permission-catalog.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./role-assignment": {
      "types": "./dist/role-assignment.d.ts",
