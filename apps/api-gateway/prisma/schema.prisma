generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerAccountOwnerType {
  PLATFORM
  USER
  MERCHANT
  PARTNER
  PUBLIC_BODY
}

enum LedgerTransactionStatus {
  PENDING
  POSTED
  REVERSED
  REJECTED
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum ReconciliationBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_MISMATCHES
  FAILED
}

enum ReconciliationItemStatus {
  PENDING
  MATCHED
  PARTIALLY_MATCHED
  MISMATCHED
  RESOLVED
  IGNORED
}

enum ReconciliationMismatchReason {
  MISSING_INTERNAL_TRANSACTION
  MISSING_PROVIDER_TRANSACTION
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  STATUS_MISMATCH
  DUPLICATE_PROVIDER_TRANSACTION
  OTHER
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String?    @unique
  phone     String?    @unique
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  wallets   Wallet[]

  @@index([status])
}

model Wallet {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  country   String          @db.Char(2)
  label     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  accounts  LedgerAccount[]

  @@index([userId])
  @@index([country])
}

model LedgerAccount {
  id              String                 @id @default(uuid()) @db.Uuid
  walletId        String?                @db.Uuid
  code            String                 @unique
  ownerType       LedgerAccountOwnerType
  ownerId         String?
  name            String
  type            LedgerAccountType
  currency        String                 @db.Char(3)
  countryCode     String                 @db.Char(2)
  isSystemAccount Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  wallet          Wallet?                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries         LedgerEntry[]
  balance         LedgerBalanceProjection?

  @@index([walletId])
  @@index([ownerType, ownerId])
  @@index([countryCode, currency])
  @@index([type, currency])
}

model LedgerTransaction {
  id                      String                  @id @default(uuid()) @db.Uuid
  reference               String                  @unique
  transactionType         String
  idempotencyKey          String                  @unique
  requestFingerprint      String
  correlationId           String
  countryCode             String                  @db.Char(2)
  status                  LedgerTransactionStatus @default(PENDING)
  description             String?
  occurredAt              DateTime
  postedAt                DateTime?
  reversedAt              DateTime?
  reversalOfTransactionId String?                 @unique @db.Uuid
  metadata                Json?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  entries                 LedgerEntry[]
  reversalOf              LedgerTransaction?      @relation("LedgerReversal", fields: [reversalOfTransactionId], references: [id], onDelete: Restrict)
  reversedBy              LedgerTransaction?      @relation("LedgerReversal")
  outboxEvents            OutboxEvent[]

  @@index([status, createdAt])
  @@index([correlationId])
  @@index([countryCode, occurredAt])
  @@index([transactionType, occurredAt])
}

model LedgerEntry {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String               @db.Uuid
  accountId     String               @db.Uuid
  sequence      Int
  direction     LedgerEntryDirection
  amountMinor   BigInt
  currency      String               @db.Char(3)
  description   String?
  postedAt      DateTime
  createdAt     DateTime             @default(now())
  transaction   LedgerTransaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, sequence])
  @@index([transactionId])
  @@index([accountId, postedAt, id])
}

model LedgerBalanceProjection {
  accountId          String        @id @db.Uuid
  availableMinor     BigInt        @default(0)
  pendingMinor       BigInt        @default(0)
  currency           String        @db.Char(3)
  lastEntryPostedAt  DateTime?
  lastEntryId        String?       @db.Uuid
  projectionSequence BigInt        @default(0)
  updatedAt          DateTime      @updatedAt
  account            LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([updatedAt])
}

model OutboxEvent {
  id            String             @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus  @default(PENDING)
  attempts      Int                @default(0)
  availableAt   DateTime           @default(now())
  publishedAt   DateTime?
  lastError     String?
  transactionId String?            @db.Uuid
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  transaction   LedgerTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([transactionId])
}

model OperationalAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  correlationId String
  actorId       String
  actorType     String
  action        String
  resourceType  String
  resourceId    String?
  reason        String?
  metadata      Json?
  occurredAt    DateTime @default(now())

  @@index([correlationId])
  @@index([action, occurredAt])
  @@index([resourceType, resourceId])
  @@index([actorId, occurredAt])
}

model ReconciliationBatch {
  id                    String                    @id @default(uuid()) @db.Uuid
  providerId            String
  sourceFileReference   String?
  sourceFingerprint     String?
  periodStart           DateTime
  periodEnd             DateTime
  status                ReconciliationBatchStatus @default(PENDING)
  totalItems            Int                       @default(0)
  matchedItems          Int                       @default(0)
  mismatchedItems       Int                       @default(0)
  resolvedItems         Int                       @default(0)
  ignoredItems          Int                       @default(0)
  failureReason         String?
  metadata              Json?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  items                 ReconciliationItem[]

  @@unique([providerId, sourceFingerprint])
  @@index([providerId, status, createdAt])
  @@index([periodStart, periodEnd])
}

model ReconciliationItem {
  id                      String                       @id @default(uuid()) @db.Uuid
  batchId                 String                       @db.Uuid
  internalReference       String?
  providerReference       String?
  internalAmountMinor     BigInt?
  providerAmountMinor     BigInt?
  currency                String                       @db.Char(3)
  internalStatus          String?
  providerStatus          String?
  providerOccurrenceCount Int                          @default(1)
  status                  ReconciliationItemStatus     @default(PENDING)
  mismatchReason          ReconciliationMismatchReason?
  rawLineFingerprint      String?
  resolutionNote          String?
  resolutionReasonCode    String?
  resolvedBy              String?
  resolutionCorrelationId String?
  resolutionIdempotencyKey String?                     @unique
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  batch                   ReconciliationBatch          @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId, status])
  @@index([batchId, mismatchReason])
  @@index([internalReference])
  @@index([providerReference])
  @@index([createdAt, id])
}
