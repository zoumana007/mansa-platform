# Environnement d’exécution : development, test, staging ou production
NODE_ENV=development

# Adresse et port d’écoute HTTP
HOST=0.0.0.0
PORT=3000

# Activer seulement derrière un proxy inverse de confiance
TRUST_PROXY=false

# Base locale de développement uniquement. Ne jamais versionner de secret réel.
DATABASE_URL=postgresql://mansa:mansa@localhost:5432/mansa?schema=public
